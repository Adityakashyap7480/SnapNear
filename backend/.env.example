NODE_ENV=development
PORT=5000

# PostgreSQL (local Postgres or Neon). Tables are created/updated automatically on startup.
# Neon: Connect > Show password gives these values; set DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=snapnear
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
# Or one full connection string instead of the DB_* values above (used first when set):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=verify-full

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Shown to suspended / blocked users so they can contact you
SUPPORT_EMAIL=support@snapnear.in

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys until KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard > Webhooks > URL https://<api-host>/api/payments/razorpay/webhook
# Events: payment.captured, order.paid, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=

# Days a paid shoot stays in the partner's wallet before the owner pays it out
PAYOUT_HOLD_DAYS=7

# Testing only: turns the 1 Hour package into an N-minute shoot (e.g. 1). Leave unset in real use.
# SHOOT_TEST_MINUTES=1

# Super Admin credentials (hardcoded defaults live in src/config/superAdmin.js)
# SUPER_ADMIN_EMAIL=superadmin@gmail.com
# SUPER_ADMIN_PASSWORD=superadmin@gmail.com
