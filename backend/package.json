{
  "name": "snapnear-backend",
  "version": "2.0.0",
  "private": true,
  "description": "SnapNear API - on-demand doorstep photographers & videographers",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
