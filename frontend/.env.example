# Leave empty in development: Vite proxies /api and /socket.io to the backend.
# In production set this to your deployed API origin, e.g. https://api.snapnear.in
VITE_API_URL=

# Fallback support address (the backend's SUPPORT_EMAIL is used when available)
VITE_SUPPORT_EMAIL=support@snapnear.in

# Backend used by the Vite dev proxy
VITE_DEV_BACKEND=http://localhost:5000
